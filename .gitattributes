* text=auto eol=lf

# These artifacts are hashed byte for byte. Never normalize source downloads.
# Preserve publisher whitespace too; it is part of the pinned source bytes.
data/sources/** -text -whitespace
data/sources/README.md text eol=lf !whitespace
data/sources/archive.json text eol=lf !whitespace
src/demeter/data/bundled/*.json text eol=lf
# Preserve the frozen sanitized acquisition receipt's exact byte hash.
docs/validation/totum-source-row-receipts-v1.json -text -whitespace
# Preserve exact authored Kerala protocol/receipt pins across platforms.
docs/validation/kerala-*.json -text -whitespace
*.xlsx binary
*.xpt binary
